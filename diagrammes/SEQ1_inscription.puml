@startuml SEQ1_Inscription
skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam sequence {
  ParticipantBackgroundColor LightBlue
  ParticipantBorderColor DarkBlue
  ActorBackgroundColor Orange
  ActorBorderColor DarkOrange
  LifeLineBorderColor DarkBlue
}
title Diagramme de Séquence — Inscription et Vérification Email

actor "Utilisateur" as U
participant "AuthView\n(Vue 3)" as V
participant "authStore\n(Pinia)" as S
participant "API Laravel\n/api/register" as API
participant "Gmail SMTP" as SMTP
database "MySQL" as DB

U -> V : Remplit le formulaire\n(nom, email, mot de passe)
V -> S : register(name, email, password)
S -> API : POST /api/register\n{name, email, password}
API -> DB : INSERT INTO users\n(name, email, password_hash)
DB --> API : Utilisateur créé
API -> SMTP : Mail::to(email)\n→ Envoie lien de vérification
SMTP --> API : OK
API --> S : 201 Created\n{user, message}
S --> V : Mise à jour état\n(utilisateur connecté)
V --> U : Redirige vers /dashboard\n+ message "Vérifiez votre email"

== Vérification email ==

U -> API : GET /email/verify/{id}/{hash}\n(clic sur le lien reçu)
API -> DB : UPDATE users\nSET email_verified_at = NOW()
DB --> API : OK
API --> U : Redirige vers /dashboard\n(email vérifié ✓)

@enduml
