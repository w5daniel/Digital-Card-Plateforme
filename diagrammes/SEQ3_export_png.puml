@startuml SEQ3_ExportPNG
skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam sequence {
  ParticipantBackgroundColor LightBlue
  ParticipantBorderColor DarkBlue
  ActorBackgroundColor Orange
  ActorBorderColor DarkOrange
}
title Diagramme de Séquence — Export PNG et Génération QR Code vCard

actor "Utilisateur" as U
participant "EditorView\n(Vue 3)" as V
participant "useEditorStore\n(Pinia)" as E
participant "QR Code Styling" as QR
participant "Konva.js\n(Stage)" as K
participant "html-to-image /\ncardExporter.js" as EXP
participant "Navigateur\n(API DOM)" as NAV

U -> V : Clique sur "Exporter PNG"
V -> E : Récupère les données\nde contact (contactData)
E --> V : { nom, email, téléphone, entreprise... }

V -> QR : Génère QR code\n(encode vCard 3.0)
note right of QR
  BEGIN:VCARD
  VERSION:3.0
  FN:Prénom Nom
  ORG:Entreprise
  TEL:+226...
  EMAIL:...
  END:VCARD
end note
QR --> V : Image QR (PNG Data URL)

V -> K : stage.toDataURL({ pixelRatio: 3 })
note right of K
  pixelRatio: 3 = export
  haute résolution (3×)
end note
K --> V : Data URL PNG (base64)

V -> EXP : exportPNG(dataURL, filename)
EXP -> NAV : Crée <a href=dataURL\ndownload=filename>
NAV --> EXP : Lien créé
EXP -> NAV : a.click() — déclenche téléchargement
NAV --> U : Fichier PNG téléchargé

== Export PDF (recto + verso) ==

V -> K : Capture recto → dataURL_recto
V -> K : Capture verso → dataURL_verso
V -> EXP : exportPDF([dataURL_recto, dataURL_verso])
EXP -> EXP : new jsPDF()\naddImage(recto)\naddPage()\naddImage(verso)\nsave()
EXP --> U : Fichier PDF téléchargé

@enduml
