@startuml UC1_Authentification
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightBlue
  BorderColor DarkBlue
  ArrowColor DarkBlue
}
skinparam actor {
  BackgroundColor Orange
  BorderColor DarkOrange
}
title Diagramme de Cas d'Utilisation — Authentification et Compte

left to right direction

actor "Visiteur" as V
actor "Utilisateur\nauthentifié" as U

V -|> U : hérite

rectangle "Authentification & Compte" {
  usecase "S'inscrire" as UC_REGISTER
  usecase "Vérifier\nl'adresse email" as UC_VERIFY
  usecase "Se connecter" as UC_LOGIN
  usecase "Réinitialiser\nle mot de passe" as UC_RESET
  usecase "Modifier\nson profil" as UC_PROFILE
  usecase "Gérer\nson avatar" as UC_AVATAR
  usecase "Se déconnecter" as UC_LOGOUT
}

V --> UC_REGISTER
V --> UC_LOGIN
V --> UC_RESET

UC_REGISTER ..> UC_VERIFY : «include»

U --> UC_PROFILE
U --> UC_AVATAR
U --> UC_LOGOUT

note right of UC_VERIFY
  Lien de vérification
  envoyé par SMTP Gmail
end note

@enduml
