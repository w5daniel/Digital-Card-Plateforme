@startuml SEQ2_SauvegardeCarte
skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam sequence {
  ParticipantBackgroundColor LightBlue
  ParticipantBorderColor DarkBlue
  ActorBackgroundColor Orange
  ActorBorderColor DarkOrange
}
title Diagramme de Séquence — Sauvegarde d'une Carte

actor "Utilisateur" as U
participant "EditorView\n(Vue 3)" as V
participant "useEditorStore\n(Pinia)" as E
participant "cardsStore\n(Pinia)" as C
participant "Axios" as AX
participant "CardController\n(Laravel)" as CTRL
database "MySQL\ncards" as DB

U -> V : Clique sur "Enregistrer"
V -> E : saveCard()
E -> E : Sérialise l'état du canvas\n{ elements, backgrounds }

E -> C : updateCard(id, { title, elements, backgrounds })
C -> AX : PUT /api/cards/{id}\n{title, elements, backgrounds}
AX -> CTRL : PUT /api/cards/{id}
CTRL -> CTRL : Vérifie propriété\n(user_id == auth()->id())

alt Carte appartient à l'utilisateur
  CTRL -> DB : UPDATE cards SET\nelements=?, backgrounds=?\nWHERE id=?
  DB --> CTRL : OK
  CTRL --> AX : 200 OK { carte mise à jour }
  AX --> C : Réponse OK
  C --> E : Carte mise à jour dans le store
  E --> V : Succès
  V --> U : Toast "Carte enregistrée ✓"
else Accès refusé
  CTRL --> AX : 403 Forbidden
  AX --> C : Erreur
  C --> V : Erreur
  V --> U : Toast "Erreur : accès refusé"
end

@enduml
