@startuml SEQ4_CreationLot
skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam sequence {
  ParticipantBackgroundColor LightBlue
  ParticipantBorderColor DarkBlue
  ActorBackgroundColor Orange
  ActorBorderColor DarkOrange
}
title Diagramme de Séquence — Création en Lot (Batch Import Excel/CSV)

actor "Utilisateur\nPremium" as U
participant "BatchCreateModal\n(Vue 3)" as V
participant "userTemplatesStore\n(Pinia)" as TS
participant "XLSX Library" as XLSX
participant "cardsStore\n(Pinia)" as CS
participant "CardController\n(Laravel API)" as CTRL
database "MySQL\ncards" as DB

U -> V : Sélectionne un template\net importe un fichier Excel/CSV
V -> XLSX : parse(fichier)
XLSX --> V : contacts[] \n[{ firstName, lastName, email, phone, company... }]
V --> U : Affiche aperçu des contacts\n(N lignes détectées)

U -> V : Confirme la création
V -> TS : createCardsFromTemplate(templateId, contacts[])

loop Pour chaque contact dans contacts[]
  TS -> TS : Clone les éléments du template
  TS -> TS : Injecte les données du contact\ndans les éléments par role\n(el.role === 'firstName' → el.text = contact.firstName)
  TS -> CS : saveCard({ title, elements, backgrounds })
  CS -> CTRL : POST /api/cards\n{ title, elements, backgrounds }
  CTRL -> DB : INSERT INTO cards
  DB --> CTRL : 201 Created
  CTRL --> CS : Carte créée
end

CS --> TS : N cartes créées
TS --> V : Résultat { créées: N, erreurs: 0 }
V --> U : "N cartes créées avec succès ✓"

@enduml
